# RuntimeConfig auto-loads .env.voice_pipeline on startup.
# Development runtime with hot reload is the only supported profile.
VOICE_PIPELINE_RUNTIME_PROFILE=development

# Required local model paths (no URLs)
VOSK_MODEL_PATH=/workspace/project/.models/vosk-model-small-en-us-0.15
VLLM_MODEL_PATH=/workspace/project/.models/Qwen3-8B
COSYVOICE3_MODEL_PATH=/workspace/project/.models/Fun-CosyVoice3-0.5B-2512

# Required cache directories
VLLM_CACHE_DIR=/workspace/project/.cache/vllm
COSYVOICE3_CACHE_DIR=/workspace/project/.cache/cosyvoice3

# Optional speaker prompt asset
COSYVOICE3_SPEAKER_PATH=

# Device contract (must remain exactly this)
VOICE_PIPELINE_ASR_DEVICE=cpu
VOICE_PIPELINE_LLM_DEVICE=cuda:0
VOICE_PIPELINE_TTS_DEVICE=cuda:1
VOICE_PIPELINE_FRAME_MS=20

# LiveKit internal URL used by backend runtime bridge.
LIVEKIT_URL=ws://127.0.0.1:7880

# LiveKit public URL returned to browser clients.
# RunPod example: wss://<pod-id>-7880.proxy.runpod.net
LIVEKIT_PUBLIC_URL=

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_ROOM_NAME=voice-runtime

# Optional API CORS override (comma-separated exact origins).
# Example: VOICE_PIPELINE_ALLOWED_ORIGINS=https://<pod-id>-5173.proxy.runpod.net
VOICE_PIPELINE_ALLOWED_ORIGINS=

# Optional frontend override for API URL.
# RunPod example: VITE_BACKEND_URL=https://<pod-id>-8000.proxy.runpod.net
# VITE_BACKEND_URL=
